#include "IR_int.h"

void IR_Init(u8 port, u8 pin)
{
    MDIO_vSetPinDir(port, pin, DIO_INPUT);
    MDIO_vSetPinVal(port, pin, DIO_HIGH);  // Enable internal pull-up
}

u8 IR_IsBlackLine(u8 port, u8 pin)
{
    // LOW = black line detected -> return 1
    if (MDIO_u8GetPinVal(port, pin) == DIO_LOW)
    {
        return 1;
    }
    return 0;  // HIGH = no black line -> return 0
}