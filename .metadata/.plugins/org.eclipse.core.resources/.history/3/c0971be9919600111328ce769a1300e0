#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>

#include "../Divers/MCAL/DIO/DIO_int.h"
#include "../Divers/LIB/STD_TYPES.h"
#include "../Divers/HAL/L298/L298_int.h"
#include "../Divers/HAL/BLUETOOTH/BLUETOOTH_int.h"
#include "../Divers/HAL/ULTRASONIC/ULTRASONIC_int.h"
#include "../Divers/HAL/IR/IR_int.h"

/* Define IR sensor pins */
#define IR_LEFT_PORT     DIO_PORTA
#define IR_LEFT_PIN      DIO_PIN1

#define IR_RIGHT_PORT    DIO_PORTA
#define IR_RIGHT_PIN     DIO_PIN0

/* Bluetooth Test Indicator Pin (e.g., PC0) */
#define BT_TEST_LED_PORT DIO_PORTC
#define BT_TEST_LED_PIN  DIO_PIN0

volatile u8 g_mode = 1; // 1 = Auto, 0 = Manual

#define MANUAL_SPEED        60u
#define AUTO_SPEED          60u

/* Per-wheel speeds */
#define MANUAL_SPEED_LEFT   (MANUAL_SPEED)
#define MANUAL_SPEED_RIGHT  (MANUAL_SPEED)
#define AUTO_SPEED_LEFT     (AUTO_SPEED)
#define AUTO_SPEED_RIGHT    (AUTO_SPEED)

/* -------------------------------------------------- */
/*               Bluetooth ISR Handler                */
/* -------------------------------------------------- */
ISR(USART_RXC_vect)
{
    u8 read = BLUETOOTH_Receive();

    /* 1. Visual Test: Toggle LED pin whenever ANY data is received over Bluetooth */
    MDIO_vTogglePinVal(BT_TEST_LED_PORT, BT_TEST_LED_PIN);

    switch (read)
    {
        case 'A': /* Auto Mode */
            g_mode = 1;
            L298_vMoveDualSpeed(MOVE_STOP, 0u, 0u);
            break;

        case 'M': /* Manual Mode */
            g_mode = 0;
            L298_vMoveDualSpeed(MOVE_STOP, 0u, 0u);
            break;

        case 'F': /* Forward */
            if (g_mode == 0) L298_vMoveDualSpeed(MOVE_FORWARD, MANUAL_SPEED_LEFT, MANUAL_SPEED_RIGHT);
            break;

        case 'B': /* Backward */
            if (g_mode == 0) L298_vMoveDualSpeed(MOVE_BACKWARD, MANUAL_SPEED_LEFT, MANUAL_SPEED_RIGHT);
            break;

        case 'R': /* Right */
            if (g_mode == 0) L298_vMoveDualSpeed(MOVE_RIGHT, MANUAL_SPEED, (MANUAL_SPEED / 2u));
            break;

        case 'L': /* Left */
            if (g_mode == 0) L298_vMoveDualSpeed(MOVE_LEFT, (MANUAL_SPEED / 2u), MANUAL_SPEED);
            break;

        case 'S': /* Stop */
            if (g_mode == 0) L298_vMoveDualSpeed(MOVE_STOP, 0u, 0u);
            break;

        /* 2. Motion Test: Sending 'T' pulses the motors for 500ms to verify reception & movement */
        case 'T':
            L298_vMoveDualSpeed(MOVE_FORWARD, 80u, 80u);
            _delay_ms(500);
            L298_vMoveDualSpeed(MOVE_STOP, 0u, 0u);
            break;

        default:
            break;
    }
}

/* -------------------------------------------------- */
/*            Line Follower Logic (2 IRs)             */
/* -------------------------------------------------- */
static void LineFollow_vUpdate(void)
{
    u8 left  = IR_IsBlackLine(IR_LEFT_PORT, IR_LEFT_PIN);
    u8 right = IR_IsBlackLine(IR_RIGHT_PORT, IR_RIGHT_PIN);

    /* Both sensors on White background (Line is centered between them) -> Move FORWARD */
    if (left == 0u && right == 0u)
    {
        L298_vMoveDualSpeed(MOVE_FORWARD, AUTO_SPEED_LEFT, AUTO_SPEED_RIGHT);
    }
    else if (left == 1u && right == 0u)
    {
        /* Left sensor sees black line -> Turn Left */
        L298_vMoveDualSpeed(MOVE_LEFT, (AUTO_SPEED / 2u), AUTO_SPEED);
    }
    else if (left == 0u && right == 1u)
    {
        /* Right sensor sees black line -> Turn Right */
        L298_vMoveDualSpeed(MOVE_RIGHT, AUTO_SPEED, (AUTO_SPEED / 2u));
    }
    else /* left == 1 && right == 1 */
    {
        /* Both sensors see black -> Stop */
        L298_vMoveDualSpeed(MOVE_STOP, 0u, 0u);
    }
}

/* -------------------------------------------------- */
/*                   Main Function                    */
/* -------------------------------------------------- */
int main(void)
{
    /* Initialize Bluetooth Test LED Pin (PC0) */
    MDIO_vSetPinDir(BT_TEST_LED_PORT, BT_TEST_LED_PIN, DIO_OUTPUT);
    MDIO_vSetPinVal(BT_TEST_LED_PORT, BT_TEST_LED_PIN, DIO_LOW);

    BLUETOOTH_Init();
    L298_vInit();
    HULTRASONIC_vInit();
    IR_Init(IR_LEFT_PORT, IR_LEFT_PIN);
    IR_Init(IR_RIGHT_PORT, IR_RIGHT_PIN);
    
    sei();

    L298_vMoveDualSpeed(MOVE_STOP, 0u, 0u);

    while (1)
    {
        if (g_mode == 1)
        {
            u16 distance = HULTRASONIC_u16GetDistance();

            if (distance <= 20u && distance > 0u)
            {
                L298_vMove(MOVE_STOP, 0u);
            }
            else
            {
                LineFollow_vUpdate();
            }
        }
        else
        {
            /* Manual mode handled in ISR */
        }

        _delay_ms(10);
    }
}